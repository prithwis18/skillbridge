# --- infra ---
POSTGRES_USER=sih
POSTGRES_PASSWORD=sih
POSTGRES_DB=sih
DATABASE_URL=postgres://sih:sih@postgres:5432/sih
REDIS_URL=redis://redis:6379

# Host-side ports only (containers always talk on 5432/6379).
# Defaults dodge a locally running Postgres/Redis.
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- ingestor ---
ADMIN_TOKEN=dev-admin-token

# --- qna agent (OpenAI-compatible; default is Groq) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=gsk_replace_me
# 3 fixed questionnaire steps + adaptive follow-ups
MAX_QUESTIONS=5

# --- hub tuning ---
MIN_COVERAGE=2
SCRAPE_WAIT_MS=8000
MAX_RECOMMENDATIONS=12

# --- web (baked at build time) ---
NEXT_PUBLIC_QNA_URL=http://localhost:3004
NEXT_PUBLIC_INGESTOR_URL=http://localhost:3003
NEXT_PUBLIC_HUB_URL=http://localhost:3001
